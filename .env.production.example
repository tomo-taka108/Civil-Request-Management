# 本番環境用 .env のひな形（インフラ設計書 6.2）。
# このファイルをコピーして本番 EC2 上に .env.production（または .env）を作り、実値を設定する。
# 実値（APP_KEY・DBパスワード等の機密）はコミットしないこと（.gitignore 済み）。
#
# ローカル開発用の .env.example とは別物。開発用の値（APP_DEBUG=true 等）を
# 本番に持ち込まないため、本番専用のひな形として分離している。

# ------------------------------------------------------------
# アプリケーション
# ------------------------------------------------------------
APP_NAME="Civil Track"
APP_ENV=production
# 未設定だと暗号化・セッションが動かない。デプロイ時に php artisan key:generate で発行する。
APP_KEY=
# 必須：true だと例外画面に環境変数・スタックトレースが露出する。本番は必ず false。
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
# 生成URL・リダイレクトの基準。取得した独自ドメインを https で設定する。
APP_URL=https://<本番ドメイン>

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

# 本番の過剰ログを抑制（デプロイ直後の切り分け時のみ debug に一時変更してよい）。
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------
# DB（RDS famigo-mysql 相乗り。本システム専用スキーマ・専用ユーザー。設計書 3.1）
# ------------------------------------------------------------
DB_CONNECTION=mysql
# RDS のエンドポイント（設計書 2.3）。ポートは 3306。
DB_HOST=famigo-mysql.cbm8aii4s3oe.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=civil_request_management
DB_USERNAME=civil_request_app
# 機密。RDS 上で CREATE USER 時に発行したパスワードを設定する。
DB_PASSWORD=
# 文字コード・照合順序はローカル・本番で揃える（設計書 3.1）。
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_ja_0900_as_cs

# ------------------------------------------------------------
# セッション / キャッシュ / キュー
# ------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 本番ドメインを設定（cookie のスコープ）。
SESSION_DOMAIN=null
# 必須：HTTPS でのみ cookie を送る。ALB で HTTPS 終端＋TrustProxies 設定が前提。
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# ------------------------------------------------------------
# メール（現状は log。実送信する場合のみ設定）
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
