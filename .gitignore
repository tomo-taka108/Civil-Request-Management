/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Claude Code のローカル/一時ファイル（共有しない）
.claude/scheduled_tasks.lock
.claude/settings.local.json

# AI で生成したサンプル写真の元画像（1枚数MBと大きいため。縮小版の置き場は #103 で決める）
/database/seeders/photos/originals/

# Terraform（インフラ設計書 §4）
# tfstate は機密（パスワード等が平文で入りうる）かつローカル保存方式のため
# コミットしない。ローカルの記録帳としてのみ扱う。
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# plan -out で保存した計画ファイル（変数の実値などを含みうる）
*.tfplan
# 変数の実値（機密を含みうる）はコミットせず、*.tfvars.example のみ共有する
*.tfvars
*.tfvars.json
!*.tfvars.example
# 上書き用ローカルファイル
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# プロバイダ lock は共有するのでコミットする（除外しない）
!.terraform.lock.hcl

# 負荷試験の結果（実行のたびに上書きされる。記録は docs/performance-test.md に残す）
/perf/results/
